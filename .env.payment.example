# 服务端独立配置：复制为 .env.payment.local。禁止把支付私钥写入 VITE_*。
PAYMENT_HOST=127.0.0.1
PAYMENT_PORT=8787
# 与正式官网域名、VITE_BASE_PATH 保持一致；沙箱本地联调示例如下。
PAYMENT_PUBLIC_ORIGIN=http://127.0.0.1:4176
PAYMENT_BASE_PATH=/
PAYMENT_DEV_ORIGIN=http://127.0.0.1:4176
PAYMENT_DATABASE_PATH=data/commerce.sqlite
# 生产反向代理必须覆盖 X-Real-IP，服务仅绑定 127.0.0.1 后才开启。
PAYMENT_TRUST_PROXY=false
# 为空则不开放经营者查询。用 openssl rand -hex 32 生成，仅保存服务端。
PAYMENT_ADMIN_TOKEN=
# 备份需位于静态站点之外，生产建议独立持久化目录。
PAYMENT_BACKUP_DIR=data/backups

# 默认关闭；先确认 shared/commerce.js 中的服务范围、价格及服务条款。
PAYMENTS_ENABLED=false
PAYMENT_CATALOG_CONFIRMED=false
# 填写支付宝实际签约主体名称，不要把品牌名或示例商户当作真实主体。
PAYMENT_MERCHANT_NAME=

# 先沙箱验证；正式收款需 production、公网 HTTPS 与已开通的电脑网站支付。
ALIPAY_ENV=sandbox
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
# 当前接入 RSA2 普通公钥模式（不是证书模式）。私钥为应用私钥；公钥为支付宝公钥。
# PEM 文件放服务端，建议权限 600。请勿提交 secrets/、数据库或私密配置到 Git。
ALIPAY_PRIVATE_KEY_PATH=secrets/alipay-app-private.pem
ALIPAY_PUBLIC_KEY_PATH=secrets/alipay-public.pem
