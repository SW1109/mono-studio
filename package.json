{
  "name": "mono-studio-vue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "scripts": {
    "dev": "node scripts/run-with-node.mjs node_modules/vite/bin/vite.js",
    "build": "node scripts/run-with-node.mjs node_modules/vite-ssg/bin/vite-ssg.js build && node scripts/run-with-node.mjs scripts/check-build.mjs",
    "preview": "node scripts/run-with-node.mjs node_modules/vite/bin/vite.js preview",
    "test": "node scripts/run-with-node.mjs --test scripts/site.test.mjs scripts/commerce.test.mjs scripts/hardening.test.mjs scripts/reliability.test.mjs",
    "test:shopxo": "node scripts/run-with-node.mjs scripts/check-shopxo.mjs",
    "check:php": "node scripts/run-with-node.mjs scripts/check-php-runtime.mjs",
    "check:build": "node scripts/run-with-node.mjs scripts/check-build.mjs",
    "server": "node scripts/run-with-node.mjs --env-file-if-exists=.env.payment.local server/index.mjs",
    "start": "npm run server",
    "release:package": "npm run build && node scripts/run-with-node.mjs scripts/package-release.mjs",
    "orders:prepare": "node scripts/run-with-node.mjs scripts/prepare-order-center.mjs",
    "orders:backup": "node scripts/run-with-node.mjs --env-file-if-exists=.env.payment.local server/backup.mjs",
    "orders:list": "node scripts/run-with-node.mjs --env-file-if-exists=.env.payment.local server/orders-cli.mjs",
    "check:node": "node scripts/run-with-node.mjs -p process.version",
    "test:browser": "node scripts/run-with-node.mjs node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.2",
    "cesium": "1.117.0",
    "vue": "^3.5.44",
    "vue-router": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "^3.5.44",
    "vite": "^7.3.7",
    "vite-ssg": "^28.3.0"
  },
  "overrides": {
    "@cesium/engine": "9.1.0",
    "@cesium/widgets": "6.1.0",
    "@zip.js/zip.js": "2.7.34"
  }
}
