{
  "name": "mono-studio-vue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite",
    "build": "vite-ssg build && node scripts/check-build.mjs",
    "preview": "vite preview",
    "test": "node --test scripts/site.test.mjs scripts/commerce.test.mjs",
    "check:build": "node scripts/check-build.mjs",
    "server": "node --env-file-if-exists=.env.payment.local server/index.mjs",
    "start": "npm run server",
    "release:package": "npm run build && node scripts/package-release.mjs",
    "orders:backup": "node --env-file-if-exists=.env.payment.local server/backup.mjs",
    "orders:list": "node --env-file-if-exists=.env.payment.local server/orders-cli.mjs"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.2",
    "cesium": "1.117.0",
    "vue": "^3.5.13",
    "vue-router": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/compiler-sfc": "^3.5.40",
    "vite": "^5.4.14",
    "vite-ssg": "^28.3.0",
    "vite-plugin-static-copy": "^2.3.0"
  },
  "overrides": {
    "@cesium/engine": "9.1.0",
    "@cesium/widgets": "6.1.0",
    "@zip.js/zip.js": "2.7.34"
  }
}
