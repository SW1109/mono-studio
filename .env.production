# 官网生产构建配置（全部为公开值：域名与商城商品 ID，不含任何密钥）。
# 缺失这些变量会让构建静默降级：商城入口退回 SPA 占位页、canonical 与 sitemap 不再输出。
VITE_SITE_URL=https://guangnian.xin
VITE_BASE_PATH=/

# 商城与官网同域，挂载在 /shop/；商品、价格、库存、账号与支付都在 ShopXO 后台管理。
VITE_SHOPXO_ORIGIN=https://guangnian.xin
VITE_SHOPXO_BASE_PATH=/shop/
# 旧单品深链直达映射，ID 为商城后台真实商品 ID；新增商品无需重建官网（未映射时进入商城首页）。
VITE_SHOPXO_PRODUCTS={"technical-review":111,"page-improvement":112,"api-integration":113,"website-starter":114,"data-automation":115,"seo-foundation":116}

# 地图与三维演示按需在本地 .env.local 中配置，不放进入仓库。
VITE_CESIUM_PROVIDER=local
