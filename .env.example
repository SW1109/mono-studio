# 官网公开配置：留空则不输出 canonical / sitemap，确认正式域名后再填写
VITE_SITE_URL=
# 域名根目录为 /；子目录部署例如 /studio/（必须以 / 开头和结尾）
VITE_BASE_PATH=/

# 演示数据源：local 不请求商用地图；仅在用户主动启动独立演示后加载
# 可选 google / ion，使用相应服务需确认权限、配额、授权及域名限制
VITE_CESIUM_PROVIDER=local
VITE_GOOGLE_MAP_TILES_API_KEY=

# 可选：通过 Cesium ion 使用 Google 3D Tiles，或切换为 ion 全球地形与 OSM Buildings
VITE_CESIUM_ION_TOKEN=

# 可选：天地图密钥 tk，用于在地球总览叠加中文地名注记（实景瓦片自带文字无法翻译）
# 申请地址 https://console.tianditu.gov.cn/api/key ，留空则不显示中文注记、维持原实景表现
VITE_TIANDITU_TOKEN=
# 可选 ShopXO 独立订单中心；两项均留空则沿用现有 Node 订单服务。
# 上线前部署订单中心、配置真实服务商品，再填写实际 HTTPS 域名与商品 ID。
VITE_SHOPXO_ORIGIN=
VITE_SHOPXO_PRODUCTS=
# 映射格式：{"technical-review":实际商品ID,"page-improvement":实际商品ID,"api-integration":实际商品ID}
