# 服务端文件放 /etc/mono-studio/payment.env，权限 640，组为 mono-studio。
PAYMENT_HOST=127.0.0.1
PAYMENT_PORT=8787
PAYMENT_PUBLIC_ORIGIN=https://replace-with-real-domain.example
PAYMENT_BASE_PATH=/
PAYMENT_DATABASE_PATH=/var/lib/mono-studio/commerce.sqlite
PAYMENT_BACKUP_DIR=/var/backups/mono-studio
PAYMENT_TRUST_PROXY=true
# 使用 openssl rand -hex 32 生成；只用于运维查询，不写入 VITE_*。
PAYMENT_ADMIN_TOKEN=
# 启动订单 API 不要求开通收款；以下保持关闭，直至实际商户验收。
PAYMENTS_ENABLED=false
PAYMENT_CATALOG_CONFIRMED=false
PAYMENT_MERCHANT_NAME=
ALIPAY_ENV=production
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=/etc/mono-studio/secrets/alipay-app-private.pem
ALIPAY_PUBLIC_KEY_PATH=/etc/mono-studio/secrets/alipay-public.pem
