[Unit]
Description=Consistent SQLite backup for Mono Studio

[Service]
Type=oneshot
User=mono-studio
Group=mono-studio
WorkingDirectory=/opt/mono-studio/current
EnvironmentFile=/etc/mono-studio/payment.env
ExecStart=/usr/bin/node /opt/mono-studio/current/server/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/mono-studio
