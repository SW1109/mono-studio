+    /** Signed query, also usable while new payments are disabled. */
+    public function Query($params = [])
+    {
+        if(empty($params['order_no']) || !is_string($params['order_no'])) return DataReturn('支付单号无效', -1);
+        $ret = $this->VerifiedApiRequest('alipay.trade.query', ['out_trade_no'=>$params['order_no']]);
+        if($ret['code'] != 0) return $ret;
+        $data = $ret['data'];
+        if(($data['out_trade_no'] ?? '') !== $params['order_no'] ||
+            !\mono\PaymentGuard::sameAmount($params['pay_price'] ?? null, $data['total_amount'] ?? null) ||
+            (!empty($data['seller_id']) && $data['seller_id'] !== $this->config['seller_id']) ||
+            (!empty($data['trans_currency']) && $data['trans_currency'] !== 'CNY'))
+        {
+            return DataReturn('查单金额、收款方或订单不匹配', -1);
+        }
+        return DataReturn('查单成功', 0, $data);
+    }
+
+    public function RefundQuery($params = [])
+    {
+        try { $request_id = \mono\PaymentGuard::refundRequestId($params); }
