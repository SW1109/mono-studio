+    private function Gateway()
+    {
+        return ($this->config['environment'] ?? 'sandbox') === 'production'
+            ? 'https://openapi.alipay.com/gateway.do'
+            : 'https://openapi-sandbox.dl.alipaydev.com/gateway.do';
+    }
+
+    private function ConfigurationError()
+    {
+        if(!in_array($this->config['environment'] ?? 'sandbox', ['sandbox', 'production'], true))
+        {
+            return '支付环境只能为 sandbox 或 production';
+        }
+        if(!preg_match('/^\d{16}$/D', $this->config['appid'] ?? '') ||
+            !preg_match('/^2088\d{12}$/D', $this->config['seller_id'] ?? ''))
+        {
+            return '请在订单后台填写有效的应用 ID 和收款方 PID';
+        }
+        if(!in_array($this->config['wap_enabled'] ?? '0', ['0', '1'], true))
+        {
+            return '请选择已开通的手机网站支付产品状态';
+        }
+        return null;
+    }
